---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { sectors } from '@/data/sectors';
import { services } from '@/data/services';
import { site } from '@/data/site';
import { faq, breadcrumbs, service as serviceSchema } from '@/lib/schema';

export const getStaticPaths = () => sectors.map((s) => ({ params: { slug: s.slug }, props: { s } }));
const { s } = Astro.props;
const path = `/sectors/${s.slug}`;
const svc = s.services.map((slug) => services.find((x) => x.slug === slug)!).filter(Boolean);
---
<Base title={s.seoTitle} description={s.description} path={path} schemas={[serviceSchema(`${s.name} security`, s.description, path), faq(s.faqs), breadcrumbs([{ name: 'Who we protect', path: '/sectors' }, { name: s.name, path }])]}>
  <PageHero eyebrow="Who we protect" title={`${s.name} security`} lead={s.short} crumbs={[{ name: 'Who we protect', path: '/sectors' }, { name: s.name, path }]} dark>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={site.phoneHref} class="btn btn-gold">Call {site.phone}</a>
      <a href="#quote" class="btn btn-ghost-light">Get a quote</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[1.3fr_1fr]">
      <div>
        {s.photo && <img src={s.photo.src} alt={s.photo.alt} width="1200" height="900" loading="eager" class="mb-10 aspect-[4/3] w-full rounded-2xl object-cover" />}
        <div class="prose-plain text-lg">{s.intro.map((p) => <p>{p}</p>)}</div>
        <div class="mt-12 grid gap-8 sm:grid-cols-2">
          <div class="rounded-2xl border border-line bg-white p-7">
            <p class="eyebrow">What usually goes wrong</p>
            <ul class="mt-4 space-y-2.5">{s.risks.map((r) => <li class="flex items-start gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-soft"></span>{r}</li>)}</ul>
          </div>
          <div class="rounded-2xl bg-ink p-7 text-paper">
            <p class="eyebrow !text-gold">How we stop it</p>
            <ul class="mt-4 space-y-2.5">{s.howWeHelp.map((h) => <li class="flex items-start gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-gold" />{h}</li>)}</ul>
          </div>
        </div>
      </div>
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div id="quote" class="card">
          <p class="font-serif text-2xl">Get a quote for your {s.name.toLowerCase()} property</p>
          <p class="mt-1 text-sm text-ink-soft">Reply within one business hour.</p>
          <div class="mt-5"><QuoteForm compact subject={`Quote: ${s.name}`} /></div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="wrap">
      <p class="eyebrow">Services used here</p>
      <h2 class="mt-3">The right tools for {s.name.toLowerCase()}</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {svc.map((x) => <ServiceCard href={`/services/${x.slug}`} name={x.name} short={x.short} icon={x.icon} />)}
      </div>
    </div>
  </section>

  <Faq items={s.faqs} title={`Questions from ${s.name.toLowerCase()} clients`} />
  <CtaBand />
</Base>
