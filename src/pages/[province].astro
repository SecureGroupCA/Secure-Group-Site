---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import { provinces } from '@/data/provinces';
import { areasIn } from '@/data/areas';
import { services } from '@/data/services';
import { sectors } from '@/data/sectors';
import { site } from '@/data/site';
import { faq, breadcrumbs, service as serviceSchema } from '@/lib/schema';

export const getStaticPaths = () => provinces.map((p) => ({ params: { province: p.slug }, props: { p } }));
const { p } = Astro.props;
const path = `/${p.slug}`;
const cities = areasIn(p.slug);
const svc = p.topServices.map((slug) => services.find((x) => x.slug === slug)!).filter(Boolean);
const sec = p.topSectors.map((slug) => sectors.find((x) => x.slug === slug)!).filter(Boolean);
const others = provinces.filter((x) => x.slug !== p.slug);
const crumbs = [{ name: 'Areas', path: '/areas' }, { name: p.name, path }];
---
<Base title={p.seoTitle} description={p.description} path={path} schemas={[serviceSchema(`Security guard services in ${p.name}`, p.description, path, p.name, 'State'), faq(p.faqs), breadcrumbs(crumbs)]}>
  <PageHero eyebrow={`Areas · ${p.name}`} title={p.h1} lead={p.lead} crumbs={crumbs} dark>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={site.phoneHref} class="btn btn-gold">Call {site.phone}</a>
      <a href="#quote" class="btn btn-ghost-light">Get a quote in {p.short}</a>
    </div>
  </PageHero>

  <section class="wrap -mt-8 relative z-10 lg:-mt-10"><TrustStrip /></section>

  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <img src={p.photo.src} alt={p.photo.alt} width="1600" height="1067" loading="eager" class="mb-10 aspect-[16/10] w-full rounded-2xl object-cover" />
        <div class="prose-plain text-lg">{p.intro.map((t) => <p>{t}</p>)}</div>

        <div class="mt-10 rounded-2xl bg-mist p-7">
          <p class="eyebrow">Licensed in {p.name}</p>
          <p class="mt-2 font-serif text-2xl">{p.licence.label}{p.licence.verified && <> #{p.licence.number}</>}</p>
          <p class="mt-2 text-ink-soft">Every guard we send here holds {p.guardLicence}. Licences are issued by the {p.licence.regulator}.</p>
          <a href={p.licence.checkUrl} rel="noopener" target="_blank" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold">How licensing works in {p.name} <Icon name="arrow" class="h-4 w-4" /></a>
          {!p.licence.verified && <p class="mt-4 text-xs text-ink-soft">Licence number to be added before launch.</p>}
        </div>

        <h2 class="mt-14">Cities we serve in {p.name}</h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {cities.map((c) => (
            <a href={`/areas/${c.slug}`} class="card flex items-center justify-between gap-4 !py-5">
              <span>
                <span class="block font-serif text-xl">{c.name}</span>
                <span class="block text-sm text-ink-soft">{c.region}</span>
              </span>
              <Icon name="arrow" class="h-5 w-5 shrink-0 text-gold" />
            </a>
          ))}
        </div>
        <p class="mt-4 text-sm text-ink-soft">Not on the list? Call us. We take jobs in many other {p.name} towns.</p>
      </div>
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div id="quote" class="card">
          <p class="font-serif text-2xl">Get a quote in {p.name}</p>
          <p class="mt-1 text-sm text-ink-soft">Reply within one business hour.</p>
          <div class="mt-5"><QuoteForm compact subject={`Quote: ${p.name}`} /></div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h2 class="mt-3">Security services in {p.name}</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {svc.map((x) => <ServiceCard href={`/services/${x.slug}`} name={x.name} short={x.short} icon={x.icon} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Who we protect in {p.name}</p>
      <h2 class="mt-3">Common clients here</h2>
      <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
        {sec.map((x) => <a href={`/sectors/${x.slug}`} class="rounded-2xl border border-line bg-white px-5 py-5 font-serif text-lg leading-tight hover:border-ink">{x.name}</a>)}
      </div>
      <h2 class="mt-14">We also protect</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {others.map((x) => <li><a href={`/${x.slug}`} class="rounded-full border border-line bg-white px-4 py-2 text-sm font-medium hover:border-ink">Security guards in {x.name}</a></li>)}
      </ul>
    </div>
  </section>

  <Faq items={p.faqs} title={`Questions from ${p.name} clients`} />
  <CtaBand title={`Need a guard in ${p.name}? Call us.`} />
</Base>
