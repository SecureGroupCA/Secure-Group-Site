---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import Icon from '@/components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { services } from '@/data/services';
import { areas } from '@/data/areas';
import { site } from '@/data/site';
import { photos } from '@/data/photos';
import { article, faq, breadcrumbs } from '@/lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
const svc = services.find((s) => s.slug === post.data.service) ?? services[0];
const area = areas.find((a) => a.slug === post.data.area) ?? areas[0];
const fmt = (d: Date) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
const all = (await getCollection('blog', ({ data }) => !data.draft)).filter((p) => p.id !== post.id).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 3);
const crumbs = [{ name: 'Blog', path: '/blog' }, { name: post.data.title, path }];
/** One photo per post; add new post ids here. Falls back to the team briefing photo. */
const postPhotos: Record<string, (typeof photos)[keyof typeof photos]> = {
  'how-to-become-a-security-guard-in-ontario': photos.teamBriefing,
  'how-to-check-if-a-security-company-is-licensed-in-ontario': photos.teamUniform,
};
const postPhoto = postPhotos[post.id] ?? photos.teamBriefing;
---
<Base title={`${post.data.title} | Secure Group`} description={post.data.description} path={path} type="article" schemas={[article({ title: post.data.title, description: post.data.description, path, published: post.data.publishDate, modified: post.data.updatedDate }), ...(post.data.faqs.length ? [faq(post.data.faqs)] : []), breadcrumbs(crumbs)]}>
  <article>
    <header class="pt-10 pb-10 lg:pt-16">
      <div class="wrap max-w-4xl">
        <Breadcrumbs items={[{ name: 'Blog', path: '/blog' }, { name: post.data.category, path: '/blog' }]} />
        <p class="eyebrow mt-8">{post.data.category}</p>
        <h1 class="mt-4">{post.data.title}</h1>
        <p class="mt-6 max-w-2xl text-xl text-ink-soft">{post.data.description}</p>
        <p class="mt-6 text-sm text-ink-soft">By {site.name} · {fmt(post.data.publishDate)}{post.data.updatedDate && ` · Updated ${fmt(post.data.updatedDate)}`}</p>
      </div>
    </header>
    <div class="wrap max-w-4xl pb-12"><img src={postPhoto.src} alt={postPhoto.alt} width="1600" height="900" loading="eager" class="aspect-[21/9] w-full rounded-2xl object-cover" /></div>
    <div class="wrap grid gap-14 pb-16 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="prose-plain max-w-3xl text-[1.08rem]"><Content /></div>
      <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
        <div class="card">
          <p class="font-serif text-xl">Need {svc.name.toLowerCase()}?</p>
          <p class="mt-1 text-sm text-ink-soft">Quote within one business hour.</p>
          <div class="mt-4"><QuoteForm compact subject={`Blog: ${post.data.title}`} /></div>
        </div>
        <div class="card">
          <p class="eyebrow">Related</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href={`/services/${svc.slug}`} class="inline-flex items-center gap-2 font-medium hover:text-gold-700">{svc.name} <Icon name="arrow" class="h-3.5 w-3.5" /></a></li>
            <li><a href={`/areas/${area.slug}`} class="inline-flex items-center gap-2 font-medium hover:text-gold-700">Security guards in {area.name} <Icon name="arrow" class="h-3.5 w-3.5" /></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
  <Faq items={post.data.faqs} title="Quick answers" />
  {all.length > 0 && (
    <section class="section bg-mist"><div class="wrap">
      <p class="eyebrow">Keep reading</p>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        {all.map((p) => <a href={`/blog/${p.id}`} class="card reveal"><p class="eyebrow">{p.data.category}</p><h3 class="mt-2 text-lg leading-snug">{p.data.title}</h3></a>)}
      </div>
    </div></section>
  )}
  <CtaBand />
</Base>
