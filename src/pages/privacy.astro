---
import Base from '@/layouts/Base.astro';
import { site } from '@/data/site';
---
<Base title="Privacy Policy | Secure Group Protection Services" description="How Secure Group Protection Services collects, uses and protects your information." noindex>
  <section class="section"><div class="wrap max-w-3xl prose-plain">
    <h1>Privacy policy</h1>
    <p>Last updated: November 2026.</p>
    <p>{site.legalName} (“we”) respects your privacy. This page explains in plain words what we collect and what we do with it.</p>
    <h2>What we collect</h2>
    <p>When you fill in a form on this site we collect what you type: your name, phone, email, the address of your property and your message. If you apply for a job we also collect your licence number and resume.</p>
    <h2>How we use it</h2>
    <p>Only to reply to you, give you a quote, or review your application. We do not sell or share your information with anyone else, except service providers who help us run this website and email.</p>
    <h2>Cookies and analytics</h2>
    <p>This site uses basic, privacy-friendly analytics to count visits. We do not use advertising cookies.</p>
    <h2>Your rights</h2>
    <p>You can ask us what we hold about you, ask us to correct it, or ask us to delete it. Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    <h2>Contact</h2>
    <p>{site.legalName}, {site.address.street}, {site.address.city}, {site.address.province} {site.address.postal}. Phone {site.phone}.</p>
  </div></section>
</Base>
