---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import { site } from '@/data/site';
import { services } from '@/data/services';
const guarding = services.filter((s) => s.group === 'guarding').slice(0, 6);
const systems = services.filter((s) => s.group === 'systems');
import { sectors } from '@/data/sectors';
import { areas } from '@/data/areas';
import { faq } from '@/lib/schema';
import { onTheJob } from '@/data/photos';

const faqs = [
  { q: 'How fast can you send a guard?', a: 'In Vaughan and nearby cities, often within 2 hours. For planned work, we usually start the same day.' },
  { q: 'Are your guards licensed?', a: 'Yes. Every guard holds a valid Ontario security guard licence. You can check any licence on the ServiceOntario website.' },
  { q: 'How much does a security guard cost?', a: 'It depends on the site, the hours and the training needed, so we price every job on its own. Call us with the address and the hours and you will have one clear hourly rate, no hidden fees, usually within the hour.' },
  { q: 'Do I have to sign a long contract?', a: 'No. You can book one shift, one weekend or a long-term post. Many clients start small and grow.' },
  { q: 'Which cities do you cover?', a: `${site.serviceArea}. Our office is in Vaughan.` },
  { q: 'Do you install cameras at homes?', a: 'Yes. We install security cameras for houses, condos and businesses. You watch them on your phone.' },
  { q: 'Do you monitor alarms?', a: 'Yes. Burglar alarms and fire alarms are connected to a 24-hour monitoring station. When one trips, help is sent.' },
];
const steps = [
  { n: '1', t: 'Call or send a quote request', d: 'Tell us the address, the hours, and what worries you.' },
  { n: '2', t: 'Get a clear plan and price', d: 'Same day. One hourly rate. No surprises.' },
  { n: '3', t: 'Your guard arrives', d: 'In uniform, licensed, often within 2 hours.' },
];
/**
 * Real 5-star Google reviews, copied word for word (typos kept). Collected 2026-11-16.
 * Long reviews are shortened with "…" only — never reworded.
 * Left out on purpose: one that mentions CCTV monitoring (we may not advertise it),
 * one that names a client, and one-word reviews.
 */
const googleReviewsUrl = 'https://www.google.com/maps/search/?api=1&query=Secure+Group+Protection+Services+Inc.';
const reviews = [
  { text: 'As the property manager of a busy office building in the GTA, I needed a reliable and trustworthy company for the installation of our building’s new security system and Secure Group fit the bill perfectly. … The customer service provided by Sunny and his workers was of the highest standard. They were professional and a pleasure to work with.', who: 'Michele R.' },
  { text: 'My Dad hired their employees for theft protection at one of our properties as we had too many break ins. Their service was outstanding and we had updates of what’s going on every 30 mins. We would love to work with this company in future. Highly recommend them over other companies who ask too much for the exact same service.', who: 'Paramveer S.' },
  { text: 'A very professional and reliable security company! I was beyond satisfied with their service and will continue to have them at future events.', who: 'Raveena R.' },
  { text: 'Very good security service. The guard MANDEEP SINGH is a really great person and helped us a lot. Hope they hire more guards like him.', who: 'Yang H.' },
  { text: 'SecureGroup is a very professional and reliable company. Our business needed a fire watch guard as our sprinkler system was not functional. The insurance company recommended SecureGroup security. They provided 1hr service, effective guard monitoring and real time reporting. Excellent team for the job. I highly recommend them for any type of security services needed.', who: 'Satinder D.' },
  { text: 'Best choice for private security! Highly recommended for small to large scale events, as well as retail loss prevention.', who: 'Jonathan C.' },
  { text: 'Hired this company last minute for a private event. Professional, courteous and timely. Jugpreet went well beyond the call of duty to ensure the safety, security, and satisfaction of all guests.', who: 'Sakaanan P.' },
  { text: 'Great company to work with. Can easily coordinate with supervisors and management when needed last minute. Very helpful during COVID times when number of people had to be limited inside my business. 100% recommended for anyone who needs around the clock security services for any small, medium or large businesses.', who: 'Harjot G.' },
  { text: 'Our Security guard mandeep singh is so helpful and delegent ,highly recommend', who: 'Wang Y.' },
  { text: 'It was a pleasure working with Secure Group. I was very satisfied with their service and professionalism. Looking forward to working with them in the future!', who: 'Hajani N.' },
  { text: 'I needed two guards for around 6 weeks for my uncle’s truck yard that was under construction. And Secure Group’s service was just phenomenal. Their mobile guards were always showing up on time, had pictures and updates sent to me every hour. I hardly visited the site until Secure Group was in-charge, you can’t ask for more.', who: 'Sanpreet S.' },
  { text: 'Highly recommend this company for all security needs. Professional and reliable!', who: 'Kristika N.' },
  { text: 'The best customer experience i ever had when it comes to security operations was with you guys,SECURE GROUP can simply be defined as the best of the bests when it comes to the quality of work, i would prefer your company over any when it comes to the fire watches or concierge you simply top the charts.Thanks for being there for me always.', who: 'Ammy R.' },
  { text: 'Hired them for a private event. Very professional and excellent service. Will hire them for another event! Thanks Secure Group Protection Services', who: 'Thishanth J.' },
  { text: 'It was a pleasure having secure group work on our property, they have really good management, excellent service, fast response service.', who: 'Ravinder M.' },
  { text: 'I was very satisfied with the services. They were very professional and I would highly recommend.', who: 'Oviyaa B.' },
  { text: 'Hired them on a last minute notice due to an unforeseen situation, and they were able to comply with all my specific needs. Will look forward to working with them in the future!', who: 'Ajanthan K.' },
  { text: 'Had them for a house party and they did a great job! Guards were professional and handled every situation perfect.', who: 'Jasmeet R.' },
  { text: 'Very professional and easy to work with ! A big thanks to everyone at The Secure Group !', who: 'Rajivan R.' },
];
---
<Base title="Security Guard Company in Vaughan & the GTA | Secure Group Protection Services" description="Licensed security guards, mobile patrol, construction site security, condo security, alarm monitoring, fire alarm monitoring and camera installation in Vaughan and across the GTA. Call 416-751-1894." schemas={[faq(faqs)]}>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink text-paper">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-gold/10 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 h-px w-full bg-gradient-to-r from-transparent via-gold/40 to-transparent"></div>
    </div>
    <div class="wrap relative grid gap-12 py-20 lg:grid-cols-[1.25fr_1fr] lg:items-center lg:py-28">
      <div>
        <p class="eyebrow !text-gold">Vaughan · Toronto · The GTA · Since {site.founded}</p>
        <h1 class="mt-5 text-display">Security guards you can call <em class="not-italic text-gold">right now.</em></h1>
        <p class="mt-7 max-w-xl text-xl text-paper/75">Licensed, uniformed guards for your building, job site, store or event. On site in as little as 2 hours. One clear price.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={site.phoneHref} class="btn btn-gold text-lg">Call {site.phone}</a>
          <a href="/contact" class="btn btn-ghost-light">Get a written quote</a>
        </div>
        <ul class="mt-10 grid max-w-xl grid-cols-1 gap-3 text-sm text-paper/80 sm:grid-cols-3">
          <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-gold" /> Licensed in Ontario</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-gold" /> Open 24 hours, 7 days</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-gold" /> No long contracts</li>
        </ul>
      </div>
      <div class="rounded-3xl border border-paper/10 bg-paper/[0.04] p-6 backdrop-blur-sm lg:p-8">
        <p class="font-serif text-2xl">Get a quote in one business hour</p>
        <p class="mt-2 text-sm text-paper/60">Fill this in or just call. Either works.</p>
        <div class="mt-6 rounded-2xl bg-paper p-5 text-ink">
          <QuoteForm compact subject="Home page quote" />
        </div>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="wrap -mt-8 relative z-10 lg:-mt-10"><TrustStrip /></section>

  <!-- Real photos -->
  <section class="section pb-0">
    <div class="wrap">
      <p class="eyebrow">On the job</p>
      <h2 class="mt-3">Real guards. Real sites.</h2>
      <p class="mt-3 max-w-2xl text-ink-soft">These are our own guards at work across the GTA. No stock photos.</p>
      <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
        {onTheJob.map((p) => <img src={p.src} alt={p.alt} width="640" height="640" loading="lazy" class="aspect-square w-full rounded-2xl object-cover" />)}
      </div>
    </div>
  </section>

  <!-- Services: guarding -->
  <section class="section">
    <div class="wrap">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow">Guards and patrols</p>
          <h2 class="mt-3">People on site. This is what we do best.</h2>
        </div>
        <p class="max-w-md text-ink-soft">Not sure which one? Call us. We will tell you honestly what fits, even if it is the cheaper option.</p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {guarding.map((s) => <ServiceCard href={`/services/${s.slug}`} name={s.name} short={s.short} icon={s.icon} />)}
      </div>
    </div>
  </section>

  <!-- Services: systems -->
  <section class="section pt-0">
    <div class="wrap">
      <div class="rounded-3xl bg-ink px-6 py-10 text-paper lg:px-12 lg:py-14">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="eyebrow !text-gold">Alarms and cameras</p>
            <h2 class="mt-3">Protection that works when nobody is there.</h2>
          </div>
          <p class="max-w-md text-paper/70">Monitored alarms and installed cameras for homes and businesses. One company for the people and the systems.</p>
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-3">
          {systems.map((s) => (
            <a href={`/services/${s.slug}`} class="group flex flex-col gap-4 rounded-2xl border border-paper/10 bg-paper/[0.04] p-7 transition-colors hover:border-gold/60 reveal">
              <span class="grid h-11 w-11 place-items-center rounded-full bg-paper/10 text-gold"><Icon name={s.icon} class="h-5 w-5" /></span>
              <h3 class="text-[1.3rem]">{s.name}</h3>
              <p class="text-[0.97rem] text-paper/70">{s.short}</p>
              <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-gold">Learn more <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section bg-mist">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="mt-3">Three steps. Usually done in a day.</h2>
        <p class="mt-5 text-ink-soft">No long forms, no sales visits. Just a phone call and a plan.</p>
        <a href="/contact" class="btn btn-ink mt-8">Start with a quote</a>
      </div>
      <ol class="grid gap-4">
        {steps.map((s) => (
          <li class="card flex gap-6 reveal">
            <span class="font-serif text-4xl text-gold">{s.n}</span>
            <div><h3>{s.t}</h3><p class="mt-1 text-ink-soft">{s.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Sectors -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Who we protect</p>
      <h2 class="mt-3 max-w-2xl">Every kind of property, from a job site to a law office.</h2>
      <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-5">
        {sectors.map((s) => (
          <a href={`/sectors/${s.slug}`} class="group rounded-2xl border border-line bg-white px-5 py-6 transition-colors hover:border-ink reveal">
            <span class="block font-serif text-lg leading-tight">{s.name}</span>
            <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-ink-soft group-hover:text-ink">See how <Icon name="arrow" class="h-3.5 w-3.5" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Vaughan focus -->
  <section class="section bg-ink text-paper">
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow !text-gold">Local to Vaughan</p>
        <h2 class="mt-3">Our office is at 90 Winges Rd. We are already here.</h2>
        <p class="mt-5 text-paper/75">When a Vaughan client calls, our guards are not driving in from across the city. We know Woodbridge, Maple, Concord, Thornhill and Kleinburg street by street.</p>
        <a href="/areas/vaughan" class="btn btn-gold mt-8">Security guards in Vaughan</a>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-paper/50">We also serve</p>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3">
          {areas.filter((a) => !a.primary).map((a) => (
            <li><a href={`/areas/${a.slug}`} class="inline-flex items-center gap-2 font-serif text-2xl hover:text-gold"><Icon name="pin" class="h-5 w-5 text-gold" /> {a.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What clients say</p>
      <h2 class="mt-3">Simple words from people we protect.</h2>
      <p class="mt-3 text-ink-soft">Rated 4.7 out of 5 from 43 Google reviews.</p>
      <div class="mt-10 columns-1 gap-5 md:columns-2 lg:columns-3">
        {reviews.map((r) => (
          <figure class="card mb-5 break-inside-avoid">
            <div class="flex gap-0.5 text-gold">{[1,2,3,4,5].map(() => <Icon name="star" class="h-4 w-4 fill-current" />)}</div>
            <blockquote class="mt-4 font-serif text-lg leading-snug">“{r.text}”</blockquote>
            <figcaption class="mt-4 text-sm text-ink-soft">{r.who} · Google review</figcaption>
          </figure>
        ))}
      </div>
      <a href={googleReviewsUrl} rel="noopener" target="_blank" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold">Read all our reviews on Google <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
  </section>

  <Faq items={faqs} title="Questions people ask us" />
  <CtaBand />
</Base>
