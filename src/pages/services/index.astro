---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { services } from '@/data/services';
import { breadcrumbs } from '@/lib/schema';
---
<Base title="Security Services in Ontario, BC & Alberta | Secure Group" description="Security guards, mobile patrol, construction site security, condo security, alarm monitoring, fire alarm monitoring, camera installation, alarm response, investigations and clean-up. Licensed in Ontario. Call 416-751-1894." schemas={[breadcrumbs([{ name: 'Services', path: '/services' }])]}>
  <PageHero eyebrow="Services" title="Pick the help you need." lead="Guards and patrols are what we are known for. We also monitor alarms and install cameras. Every service is backed by a 24-hour dispatch desk." crumbs={[{ name: 'Services', path: '/services' }]} />
  <section class="wrap pb-16">
    <p class="eyebrow">Guards and patrols</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.filter((s) => s.group === 'guarding').map((s) => <ServiceCard href={`/services/${s.slug}`} name={s.name} short={s.short} icon={s.icon} />)}
    </div>
    <p class="eyebrow mt-16">Alarms and cameras</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.filter((s) => s.group === 'systems').map((s) => <ServiceCard href={`/services/${s.slug}`} name={s.name} short={s.short} icon={s.icon} />)}
    </div>
  </section>
  <CtaBand title="Not sure which service fits?" text="Call us. We will ask a few questions and tell you the simplest option, even if it is the cheaper one." />
</Base>
