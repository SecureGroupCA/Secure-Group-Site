---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import { services } from '@/data/services';
import { sectors } from '@/data/sectors';
import { areas } from '@/data/areas';
import { site } from '@/data/site';
import { service as serviceSchema, faq, breadcrumbs } from '@/lib/schema';

export const getStaticPaths = () => services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
const { s } = Astro.props;
const path = `/services/${s.slug}`;
const related = sectors.filter((x) => x.services.includes(s.slug)).slice(0, 4);
const others = services.filter((x) => x.slug !== s.slug).slice(0, 3);
---
<Base title={s.seoTitle} description={s.description} path={path} schemas={[serviceSchema(s.name, s.description, path), faq(s.faqs), breadcrumbs([{ name: 'Services', path: '/services' }, { name: s.name, path }])]}>
  <PageHero eyebrow="Service" title={s.name} lead={s.short} crumbs={[{ name: 'Services', path: '/services' }, { name: s.name, path }]} dark>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={site.phoneHref} class="btn btn-gold">Call {site.phone}</a>
      <a href="#quote" class="btn btn-ghost-light">Get a quote</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <div class="prose-plain text-lg">
          {s.intro.map((p) => <p>{p}</p>)}
        </div>
        <h2 class="mt-14">What you get</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {s.whatYouGet.map((w) => <li class="flex items-start gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-gold" /><span>{w}</span></li>)}
        </ul>
        <h2 class="mt-14">How it works</h2>
        <ol class="mt-6 grid gap-4 sm:grid-cols-2">
          {s.howItWorks.map((h, i) => (
            <li class="card reveal"><span class="font-serif text-3xl text-gold">{i + 1}</span><h3 class="mt-2 text-lg">{h.step}</h3><p class="mt-1 text-ink-soft">{h.text}</p></li>
          ))}
        </ol>
        <div class="mt-14 rounded-2xl bg-mist p-7">
          <p class="eyebrow">About price</p>
          <p class="mt-3 text-lg">{s.priceNote}</p>        </div>
      </div>
      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div id="quote" class="card">
          <p class="font-serif text-2xl">Get a quote for {s.name.toLowerCase()}</p>
          <p class="mt-1 text-sm text-ink-soft">Reply within one business hour.</p>
          <div class="mt-5"><QuoteForm compact subject={`Quote: ${s.name}`} preselect={s.name} /></div>
        </div>
        {(s.slug === 'fire-alarm-monitoring' || s.slug === 'alarm-monitoring') && (
          <div class="card">
            <p class="eyebrow">Licensed monitoring</p>
            <p class="mt-3 text-[0.97rem]">Monitoring is done through a ULC-listed station.</p>
            <p class="mt-1 text-sm text-ink-soft">ULC licence {site.ulc.number}</p>
          </div>
        )}
        <div class="card">
          <p class="eyebrow">Good for</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {s.goodFor.map((g) => <li class="rounded-full border border-line px-3 py-1 text-sm">{g}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section bg-mist">
      <div class="wrap">
        <p class="eyebrow">Who uses this</p>
        <h2 class="mt-3">Sectors that rely on {s.name.toLowerCase()}</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => <a href={`/sectors/${r.slug}`} class="card reveal"><h3 class="text-lg">{r.name}</h3><p class="mt-2 text-sm text-ink-soft">{r.short}</p></a>)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Where</p>
      <h2 class="mt-3">{s.name} by city</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {areas.map((a) => <li><a href={`/areas/${a.slug}`} class="rounded-full border border-line bg-white px-4 py-2 text-sm font-medium hover:border-ink">{s.name} in {a.name}</a></li>)}
      </ul>
      <h2 class="mt-14">Other services</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {others.map((o) => <li><a href={`/services/${o.slug}`} class="card block reveal"><h3 class="text-lg">{o.name}</h3><p class="mt-2 text-sm text-ink-soft">{o.short}</p></a></li>)}
      </ul>
    </div>
  </section>

  <Faq items={s.faqs} title={`Questions about ${s.name.toLowerCase()}`} />
  <CtaBand />
</Base>
