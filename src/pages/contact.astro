---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import { site } from '@/data/site';
import { breadcrumbs } from '@/lib/schema';
import { photos } from '@/data/photos';
---
<Base title="Contact Secure Group | Security Guards in Vaughan, 24/7 | 416-751-1894" description="Call 416-751-1894 any time, day or night. Head office at 90 Winges Rd, Suite 206, Vaughan. Serving Ontario, BC and Alberta. Get a security guard quote within one business hour." schemas={[breadcrumbs([{ name: 'Contact', path: '/contact' }])]}>
  <PageHero eyebrow="Contact" title="Call us. We pick up." lead="Day or night. Tell us the address and the hours and we will give you a price and a start time." crumbs={[{ name: 'Contact', path: '/contact' }]} />
  <section class="wrap pb-12"><img src={photos.stockWetRoad.src} alt={photos.stockWetRoad.alt} width="1600" height="900" loading="eager" class="aspect-[21/9] w-full rounded-2xl object-cover" /></section>
  <section class="wrap pb-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <div class="space-y-5">
        <a href={site.phoneHref} class="card flex items-center gap-5 !py-6">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-ink text-gold"><Icon name="phone" class="h-5 w-5" /></span>
          <span><span class="block font-serif text-2xl">{site.phone}</span><span class="text-sm text-ink-soft">{site.hours}</span></span>
        </a>
        <a href={site.quoteMailto} class="card flex items-center gap-5 !py-6">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-mist"><Icon name="arrow" class="h-5 w-5" /></span>
          <span><span class="block font-serif text-xl">{site.email}</span><span class="text-sm text-ink-soft">Reply within one business hour</span></span>
        </a>
        <div class="card flex items-start gap-5 !py-6">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-mist"><Icon name="pin" class="h-5 w-5" /></span>
          <span><span class="block font-serif text-xl">{site.address.street}</span><span class="block">{site.address.city}, {site.address.province} {site.address.postal}</span><span class="text-sm text-ink-soft">Off Highway 7 and Weston Rd, Woodbridge</span></span>
        </div>
        <div class="overflow-hidden rounded-2xl border border-line">
          <iframe title="Map to Secure Group office" src="https://www.google.com/maps?q=90+Winges+Rd+Suite+206+Vaughan+ON+L4L+6A9&output=embed" width="100%" height="260" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
      <div class="card">
        <p class="font-serif text-2xl">Get a written quote</p>
        <p class="mt-1 text-sm text-ink-soft">A few details and we will send a clear price.</p>
        <div class="mt-6"><QuoteForm subject="Contact page quote" /></div>
      </div>
    </div>
  </section>
</Base>
