---
import { site, nav } from '@/data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const active = (href: string) => (href === '/areas/vaughan' ? path.startsWith('/areas') : path.startsWith(href));
---
<header id="site-header" class="sticky top-0 z-40 border-b border-line/0 bg-paper/85 backdrop-blur-md transition-[border-color] duration-300">
  <div class="wrap flex items-center justify-between py-2.5">
    <a href="/" class="flex items-center" aria-label={`${site.name} — home`}>
      <img src="/images/logo-black.png" alt={`${site.name} logo`} width="587" height="365" class="h-14 w-auto lg:h-16" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {nav.map((i) => (
        <a href={i.href} class:list={['text-[0.9rem] font-medium transition-opacity hover:opacity-60', active(i.href) && 'underline decoration-gold decoration-2 underline-offset-8']} aria-current={active(i.href) ? 'page' : undefined}>{i.label}</a>
      ))}
      <a href={site.phoneHref} class="text-[0.9rem] font-semibold">{site.phone}</a>
      <a href="/contact" class="btn btn-ink text-[0.85rem] !py-2.5 !px-5">Get a quote</a>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      <a href={site.phoneHref} class="grid h-11 w-11 place-items-center rounded-full bg-ink text-gold" aria-label="Call us"><Icon name="phone" class="h-5 w-5" /></a>
      <button id="nav-toggle" class="grid h-11 w-11 place-items-center" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span class="nav-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden lg:hidden" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="flex h-[100dvh] flex-col justify-between bg-paper px-6 pb-10 pt-6">
      <nav class="flex flex-col" aria-label="Mobile">
        {nav.map((i) => (
          <a href={i.href} class="border-b border-line py-4 font-serif text-3xl">{i.label}</a>
        ))}
        <a href="/contact" class="border-b border-line py-4 font-serif text-3xl">Contact</a>
      </nav>
      <div class="flex flex-col gap-3">
        <a href={site.phoneHref} class="btn btn-ink">Call {site.phone}</a>
        <a href="/contact" class="btn btn-outline">Get a quote</a>
        <p class="text-center text-sm text-ink-soft">{site.hours}</p>
      </div>
    </div>
  </div>
</header>

<style>
  #site-header.is-scrolled { border-color: var(--color-line); }
  .nav-icon { display: flex; flex-direction: column; gap: 6px; width: 22px; }
  .nav-icon span { height: 1.5px; width: 100%; background: var(--color-ink); transition: transform .25s ease; }
  #nav-toggle[aria-expanded='true'] .nav-icon span:first-child { transform: translateY(3.75px) rotate(45deg); }
  #nav-toggle[aria-expanded='true'] .nav-icon span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  addEventListener('scroll', () => header?.classList.toggle('is-scrolled', scrollY > 12), { passive: true });
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    menu?.classList.toggle('hidden', open);
    document.body.classList.toggle('overflow-hidden', !open);
  });
</script>
