---
import { site } from '@/data/site';
import { services } from '@/data/services';
import { provinces } from '@/data/provinces';
import { areasIn } from '@/data/areas';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-paper">
  <div class="wrap py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <img src="/images/logo-white.png" alt={`${site.name} logo`} width="587" height="365" loading="lazy" class="h-16 w-auto" />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-paper/70">Licensed security guards, patrols and monitoring across Ontario, British Columbia and Alberta. Head office in Vaughan. Since {site.founded}.</p>
        <div class="mt-6 space-y-2 text-sm">
          <p><a href={site.phoneHref} class="font-semibold hover:text-gold">{site.phone}</a> <span class="text-paper/50">· {site.hours}</span></p>
          <p><a href={site.quoteMailto} class="hover:text-gold">{site.email}</a></p>
          <p class="text-paper/70">{site.address.street}, {site.address.city}, {site.address.province} {site.address.postal}</p>
          {site.licence.verified && <p class="text-paper/70">PSISA agency licence #{site.licence.number}</p>}
        </div>
        {(site.social.instagram || site.social.linkedin || site.social.facebook) && (
          <p class="mt-5 flex gap-5 text-sm">
            {site.social.instagram && <a href={site.social.instagram} rel="noopener" target="_blank" class="text-paper/75 hover:text-gold">Instagram</a>}
            {site.social.linkedin && <a href={site.social.linkedin} rel="noopener" target="_blank" class="text-paper/75 hover:text-gold">LinkedIn</a>}
            {site.social.facebook && <a href={site.social.facebook} rel="noopener" target="_blank" class="text-paper/75 hover:text-gold">Facebook</a>}
          </p>
        )}
      </div>
      <nav aria-label="Services">
        <p class="eyebrow !text-gold">Services</p>
        <ul class="mt-5 space-y-2.5 text-sm">
          {services.map((s) => <li><a href={`/services/${s.slug}`} class="text-paper/75 hover:text-paper">{s.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Areas">
        <p class="eyebrow !text-gold">Areas we serve</p>
        <ul class="mt-5 space-y-2.5 text-sm">
          {provinces.map((p) => (
            <li>
              <a href={`/${p.slug}`} class="font-semibold text-paper hover:text-gold">{p.name}</a>
              <p class="mt-1 text-xs leading-relaxed text-paper/60">{areasIn(p.slug).slice(0, 5).map((a, i) => <>{i > 0 && ' · '}<a href={`/areas/${a.slug}`} class="hover:text-paper">{a.name}</a></>)}</p>
            </li>
          ))}
          <li><a href="/areas" class="text-paper/75 hover:text-paper">All areas →</a></li>
        </ul>
      </nav>
      <nav aria-label="Company">
        <p class="eyebrow !text-gold">Company</p>
        <ul class="mt-5 space-y-2.5 text-sm">
          <li><a href="/about" class="text-paper/75 hover:text-paper">About us</a></li>
          <li><a href="/sectors" class="text-paper/75 hover:text-paper">Who we protect</a></li>
          <li><a href="/blog" class="text-paper/75 hover:text-paper">Blog</a></li>
          <li><a href="/careers" class="text-paper/75 hover:text-paper">Careers</a></li>
          <li><a href="/contact" class="text-paper/75 hover:text-paper">Contact</a></li>
          <li><a href="/privacy" class="text-paper/75 hover:text-paper">Privacy</a></li>
        </ul>
      </nav>
    </div>
    <div class="mt-14 flex flex-col gap-3 border-t border-paper/10 pt-6 text-xs text-paper/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.legalName}. Licensed security services in Ontario, British Columbia and Alberta.</p>
      <p>{site.insurance}.</p>
    </div>
  </div>
</footer>
